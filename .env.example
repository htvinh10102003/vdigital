# VDigital — copy thành .env.local (local) và nhập vào Vercel > Settings > Environment Variables.
# KHÔNG commit file .env.local / .env chứa key thật.

# --- Supabase (bắt buộc để có dữ liệu thật + đăng nhập + admin) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng phía server (API routes / webhook). KHÔNG bao giờ lộ ra client.
SUPABASE_SERVICE_ROLE_KEY=

# --- PayOS (thanh toán tự động VietQR — miễn phí, 0% / giao dịch, tiền về thẳng MB Bank) ---
# Lấy tại https://my.payos.vn sau khi đăng ký và liên kết tài khoản MB Bank nhận tiền.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# URL web (Vercel): ví dụ https://vdigital.vercel.app — PayOS dùng làm return/cancel URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Ngân hàng nhận tiền (hiển thị ở trang thanh toán demo / khi chưa có PayOS) ---
MB_BANK_NAME=MB Bank
MB_BANK_ACCOUNT=
MB_BANK_ACCOUNT_NAME=

# --- Admin: email được quyền vào /admin, phân tách bằng dấu phẩy ---
ADMIN_EMAILS=
# (tuỳ chọn) hiện cùng danh sách ở client chỉ để ẩn/hiện link admin. Quyền thật do API kiểm tra bằng ADMIN_EMAILS.
NEXT_PUBLIC_ADMIN_EMAILS=

# --- Email (gửi mail tự động): Gmail RIÊNG của shop qua SMTP + App Password ---
# Nên dùng Gmail riêng cho shop, không dùng Gmail cá nhân.
# Cách tạo: bật xác minh 2 bước (2FA) cho Gmail shop đó, rồi vào
# myaccount.google.com > Bảo mật > Mật khẩu ứng dụng > tạo mới, lấy 16 ký tự.
# Nhập 16 ký tự đó vào SMTP_PASS qua trang nhập an toàn / Vercel env.
# KHÔNG gửi App Password trong chat, KHÔNG ghi vào code.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=VDigital <shop@gmail.com>
